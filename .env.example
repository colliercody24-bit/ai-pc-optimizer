# AI PC Optimizer Configuration

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable/disable features
ENABLE_AUTO_UPDATES=true
ENABLE_DRIVER_UPDATES=true
ENABLE_PERFORMANCE_OPTIMIZATION=true
ENABLE_FILE_SYSTEM_CLEANUP=true

# Scan interval in minutes (for scheduled runs)
SCAN_INTERVAL_MINUTES=60

# Maximum age in days for temp files before cleanup
TEMP_FILE_MAX_AGE_DAYS=7

# Custom cleanup paths (comma-separated)
CLEANUP_PATHS=

# ===========================================
# AI Provider Configuration
# ===========================================
# Choose your AI provider: rule-based, ollama, or gemini
# - rule-based: Built-in analysis (no AI, always works)
# - ollama: Local AI (free, private, requires Ollama installed)
# - gemini: Google Gemini (cloud, free tier available)
AI_PROVIDER=rule-based

# ===========================================
# Ollama Configuration (Local AI - Free)
# ===========================================
# Ollama runs AI models locally on your machine
# Setup: 
#   1. Download from https://ollama.ai
#   2. Run: ollama serve
#   3. Pull a model: ollama pull llama2
# 
# Available models: llama2, mistral, codellama, phi, neural-chat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===========================================
# Google Gemini Configuration (Cloud AI)
# ===========================================
# Free tier: 15 requests/min, 1 million tokens/month
# Get your API key: https://makersuite.google.com/app/apikey
# 
# Pricing (beyond free tier):
# - See https://ai.google.dev/pricing
#
# Available models: gemini-pro, gemini-pro-vision
AI_API_KEY=
GEMINI_MODEL=gemini-pro
